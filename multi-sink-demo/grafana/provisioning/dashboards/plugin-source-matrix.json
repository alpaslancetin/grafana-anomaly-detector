          "query": "from(bucket: \"anomaly\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"grafana_anomaly\" and r._field == \"score\" and r.record_type == \"rule\" and contains(value: r.rule, set: [\"checkout_latency\", \"checkout_traffic\", \"checkout_error_rate\"])) |> aggregateWindow(every: 1m, fn: max, createEmpty: false) |> yield(name: \"score\")",
          "refId": "A"
