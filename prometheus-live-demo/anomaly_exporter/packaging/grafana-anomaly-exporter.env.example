ANOMALY_CONFIG_PATH=/etc/grafana-anomaly-exporter/config.yml
ANOMALY_DYNAMIC_RULES_PATH=/var/lib/grafana-anomaly-exporter/dynamic_rules.json
ANOMALY_PROMETHEUS_URL=http://127.0.0.1:9090
ANOMALY_LISTEN_HOST=127.0.0.1
ANOMALY_LISTEN_PORT=9110
ANOMALY_EVALUATION_INTERVAL_SECONDS=10
ANOMALY_REQUEST_TIMEOUT_SECONDS=10
ANOMALY_CONFIG_RELOAD_INTERVAL_SECONDS=10

# Optional API path/security settings. Comma-separate list values.
ANOMALY_BASE_PATH=/anomalyalarm
ANOMALY_CORS_ALLOWED_ORIGINS=https://grafana.example.com
ANOMALY_ALLOWED_DATASOURCE_HOSTS=prometheus.example.com:9090,influxdb.example.com:8086
ANOMALY_API_TOKEN_ENV=ANOMALY_API_TOKEN
ANOMALY_MAX_REQUEST_BODY_BYTES=1048576
# ANOMALY_API_TOKEN=replace-through-a-secret-manager

# Optional multi-datasource sinks. Leave disabled to keep Prometheus-only mode.
# ANOMALY_SINK_LOKI_ENABLED=false
# ANOMALY_SINK_LOKI_URL=http://127.0.0.1:3100
# ANOMALY_SINK_INFLUX_ENABLED=false
# ANOMALY_SINK_INFLUX_URL=http://127.0.0.1:8086
# ANOMALY_SINK_INFLUX_ORG=anomaly
# ANOMALY_SINK_INFLUX_BUCKET=anomaly
# ANOMALY_SINK_INFLUX_TOKEN=
# ANOMALY_SINK_PG_ENABLED=false
# ANOMALY_SINK_PG_DSN=postgresql://anomaly:anomaly@127.0.0.1:5432/anomaly
# ANOMALY_SINK_CH_ENABLED=false
# ANOMALY_SINK_CH_URL=http://127.0.0.1:8123
# ANOMALY_SINK_ES_ENABLED=false
# ANOMALY_SINK_ES_URL=http://127.0.0.1:9200
